<?xml version="1.0" encoding="UTF-8"?>
<Include>
	<!-- Product GUIDs & Version Number -->
    <?ifndef ProductCode ?>
        <?define ProductCode =          "*"?>
    <?endif ?>
    <?ifndef ProductLanguage ?>
        <?define ProductLanguage =      "1033"?>
    <?endif ?>
    <?if $(var.RELTYPE) = PRODUCTION ?>
        <?define ProductVersion =           "$(var.MAJVER).$(var.MINVER).$(var.PATCH)"?>
        <?define UpgradeCode =              "E119436B-4696-4D57-94B0-09CBF6592FE9"?>
        <?define UpgradeCodeAlt =           "F254AD7A-05B6-498A-A01D-DC845C134B59"?>
    <?else ?>
        <?define ProductVersion =           "$(var.MAJVER).$(var.MINVER).$(var.PATCH).$(var.BUILD)"?>
        <?define UpgradeCode =              "F254AD7A-05B6-498A-A01D-DC845C134B59"?>
        <?define UpgradeCodeAlt =           "E119436B-4696-4D57-94B0-09CBF6592FE9"?>
    <?endif ?>

	<!-- Product and Company information -->
    <?define ProductName =              "Smart Storage"?>
    <?define ProductFolder =            "Smart Storage"?>
    <?define Manufacturer =             "StrokeDot"?>
    <?define Contact =                  "https://github.com/StrokeDot"?>
    <?define AboutLink =                "https://github.com/StrokeDot/windirstat"?>
    <?define HelpLink =                 "https://github.com/StrokeDot/windirstat"?>
    <?define UpdateLink =               "https://github.com/StrokeDot/windirstat"?>
    <?define ReadMeLink =               "https://github.com/StrokeDot/windirstat"?>
    <?define IconFilePath =             "..\..\windirstat\res\WinDirStat.ico" ?>

    <?define ProductBinariesDir =       "..\..\build"?>
    <?ifndef LicenseRtf ?>
        <?define LicenseRtf =               "license.rtf"?>
    <?endif ?>
    <?define BannerBmp =                "banner.bmp"?>
    <?define DialogBmp =                "background.bmp"?>

    <?define WinDirStatExe = "WinDirStat_$(sys.BUILDARCH).exe" ?>
	<?if $(sys.BUILDARCH) = x64 Or $(sys.BUILDARCH) = arm64 ?>
    <?define Win64 = "yes" ?>
    <?define ProgramFilesNative = "ProgramFiles64Folder" ?>
    <?else ?>
    <?define Win64 = "no" ?>
    <?define ProgramFilesNative = "ProgramFilesFolder" ?>
    <?endif ?>
    <!-- Default Registry Key, in which most registry settings are saved. -->
    <?define ProductRegKeyPath = "SOFTWARE\StrokeDot\SmartStorage"?>
    <?if $(var.RELTYPE) = PRODUCTION ?>
	<?define AllowSameVersionUpgrades = "no"?>
    <?else ?>
	<?define AllowSameVersionUpgrades = "yes"?>
    <?endif ?>
</Include>
